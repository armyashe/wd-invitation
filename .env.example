# ==============================================================================
# COUPLE CONFIGURATION (Thông tin cô dâu và chú rể)
# Cấu hình trên Vercel Dashboard: Project Settings -> Environment Variables
# ==============================================================================
# Họ và tên đầy đủ của Chú rể
VITE_GROOM_FULL_NAME=Daniel Roman
# Tên gọi thân mật / tên ngắn của Chú rể (dùng cho logo chữ lồng, viết tắt)
VITE_GROOM_SHORT_NAME=Daniel

# Họ và tên đầy đủ của Cô dâu
VITE_BRIDE_FULL_NAME=Jamie Le
# Tên gọi thân mật / tên ngắn của Cô dâu (dùng cho logo chữ lồng, viết tắt)
VITE_BRIDE_SHORT_NAME=Jamie

# ==============================================================================
# WEDDING CONFIGURATION (Cấu hình sự kiện cưới cho từng Vercel Project)
# Cấu hình trên Vercel Dashboard: Project Settings -> Environment Variables
# ==============================================================================

# Thời gian mục tiêu cho đồng hồ đếm ngược (ISO format: YYYY-MM-DDTHH:mm:ss)
# Ví dụ: 2026-12-06T18:00:00 (nhà trai) hoặc 2026-12-12T11:00:00 (nhà gái)
VITE_WEDDING_TARGET_DATE=2026-12-06T18:00:00

# Tiêu đề lễ cưới (ví dụ: 'TIỆC MỪNG TÂN HÔN' cho nhà trai, 'TIỆC MỪNG VU QUY' cho nhà gái)
VITE_WEDDING_TITLE=TIỆC MỪNG TÂN HÔN

# Ngày cưới hiển thị trên thiệp
VITE_WEDDING_DATE_FORMATTED=Chủ Nhật, 06.12.2026

# Thông tin ngày âm lịch & giờ tổ chức
VITE_WEDDING_LUNAR_TEXT=Âm lịch 28 tháng 10 Năm Bính Ngọ | Lúc 18:00 PM

# Tên trung tâm hội nghị tiệc cưới hoặc tư gia
VITE_WEDDING_VENUE_NAME=Trung tâm hội nghị - tiệc cưới Venus Luxury

# Tên sảnh tiệc (nếu có)
VITE_WEDDING_VENUE_HALL=Sảnh Hera - Tầng 3

# Địa chỉ tổ chức
VITE_WEDDING_VENUE_ADDRESS=117-117A Lê Trọng Tấn, Phường Tân Sơn Nhì, Tp.Hồ Chí Minh

# URL nhúng bản đồ Google Maps (thuộc tính src của thẻ iframe)
VITE_WEDDING_MAP_EMBED_URL=https://www.google.com/maps/embed?pb=...

# Link mở ứng dụng Google Maps trực tiếp để chỉ đường
VITE_WEDDING_MAP_EXTERNAL_URL=https://maps.app.goo.gl/...

# ==============================================================================
# BANKING CONFIGURATION (Cấu hình tài khoản ngân hàng mừng cưới duy nhất)
# Mỗi Vercel Project chỉ cấu hình 1 tài khoản và 1 mã QR
# ==============================================================================

# Người nhận quà mừng: 'groom' (Chú rể) hoặc 'bride' (Cô dâu). Mặc định là groom.
VITE_BANK_RECIPIENT=groom

# Tên ngân hàng (ví dụ: Sacombank, Vietcombank, MB Bank,...)
VITE_BANK_NAME=Sacombank

# Số tài khoản ngân hàng
VITE_BANK_ACCOUNT_NUMBER=

# Tên chủ tài khoản (in hoa không dấu hoặc có dấu)
VITE_BANK_ACCOUNT_HOLDER=

# Đường dẫn URL ảnh mã QR chuyển khoản (trên Supabase Storage hoặc CDN)
VITE_BANK_QR_URL=

# ==============================================================================
# SUPABASE CONFIGURATION
# ==============================================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
