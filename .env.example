# ==============================================================================
# COUPLE CONFIGURATION
# Configure on Vercel Dashboard: Project Settings -> Environment Variables
# ==============================================================================
# Groom's full name
VITE_GROOM_FULL_NAME=Daniel Roman
# Groom's short name (used for monogram logo, initials, and short labels)
VITE_GROOM_SHORT_NAME=Daniel

# Bride's full name
VITE_BRIDE_FULL_NAME=Jamie Le
# Bride's short name (used for monogram logo, initials, and short labels)
VITE_BRIDE_SHORT_NAME=Jamie

# ==============================================================================
# WEDDING CONFIGURATION (Configured individually for each Vercel Project)
# Configure on Vercel Dashboard: Project Settings -> Environment Variables
# ==============================================================================

# Target date for countdown timer (ISO format: YYYY-MM-DDTHH:mm:ss)
# Example: 2026-12-06T18:00:00 (groom side) or 2026-12-12T11:00:00 (bride side)
VITE_WEDDING_TARGET_DATE=2026-12-06T18:00:00

# Wedding ceremony title (e.g. 'WEDDING RECEPTION' for groom, 'BRIDAL CELEBRATION' for bride)
VITE_WEDDING_TITLE=WEDDING RECEPTION

# Wedding date displayed on invitation
VITE_WEDDING_DATE_FORMATTED=Sunday, December 6, 2026

# Event schedule or additional date info
VITE_WEDDING_LUNAR_TEXT=Ceremony begins at 6:00 PM | Dinner Reception at 7:00 PM

# Convention center, wedding venue, or private residence name
VITE_WEDDING_VENUE_NAME=The Grand Crystal Palace

# Wedding hall name (Optional: leave empty if held at a private home or no dedicated hall; line will be hidden)
VITE_WEDDING_VENUE_HALL=Grand Ballroom - 3rd Floor

# Venue address
VITE_WEDDING_VENUE_ADDRESS=55 Wall Street, New York, NY 10005, USA

# Google Maps embed URL (src attribute of iframe)
VITE_WEDDING_MAP_EMBED_URL=https://www.google.com/maps/embed?pb=...

# Direct external link to open Google Maps navigation
VITE_WEDDING_MAP_EXTERNAL_URL=https://maps.app.goo.gl/...

# ==============================================================================
# BANKING CONFIGURATION (Single bank account per Vercel Project)
# Each Vercel Project configures only one bank account and one QR code
# ==============================================================================

# Gift recipient: 'groom' or 'bride'. Default is 'groom'.
VITE_BANK_RECIPIENT=groom

# Bank name (e.g. Chase Bank, Bank of America, Citibank, etc.)
VITE_BANK_NAME=Chase Bank

# Bank account number
VITE_BANK_ACCOUNT_NUMBER=123456789012

# Account holder name (UPPERCASE)
VITE_BANK_ACCOUNT_HOLDER=DANIEL ROMAN

# URL path to bank transfer QR code image (hosted on Supabase Storage or CDN)
VITE_BANK_QR_URL=https://example.com/wedding-qr.jpg

# ==============================================================================
# SUPABASE CONFIGURATION
# ==============================================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
